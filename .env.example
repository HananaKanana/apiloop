# 复制为 .env 后按需修改（.env 不会提交到 git）

# 对外端口（容器里固定是 8080）。线上 http://leonaz.top:8765
PORT=8765

# 首次启动时 admin 的密码；留空则随机生成并打印在日志里
ADMIN_PASSWORD=

# 网页版能不能发请求（由服务器代发）。默认 0：不发，请求从客户端发出（接口在内网时推荐）。
# 接口都在公网、想让同事不装客户端也能调，就改成 1
# SERVER_SEND=0

# 国内网络构建慢时改用镜像源（./deploy.sh up --cn 会自动设置）
# NPM_REGISTRY=https://registry.npmmirror.com
