<Project Sdk="Microsoft.NET.Sdk">
  <!--
    apiloop 的 Windows 安装程序：一个 exe，里面嵌着 payload.zip（node.exe、app、apiloop.exe）。
    装到 %LOCALAPPDATA%\Programs\apiloop，不需要管理员权限。

    build.sh 传进来：-p:Version=... -p:ApiloopPayload=<payload.zip> -p:ApiloopIcon=<apiloop.ico>
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>apiloop-setup</AssemblyName>
    <RootNamespace>Apiloop</RootNamespace>
    <ApplicationIcon>$(ApiloopIcon)</ApplicationIcon>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <Version>0.0.0</Version>
    <Product>apiloop</Product>
    <Company>apiloop</Company>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Installation.cs" />
    <EmbeddedResource Include="$(ApiloopPayload)" LogicalName="payload.zip" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
