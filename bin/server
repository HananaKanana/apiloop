#!/usr/bin/env node

/**
 * Handle cli input
 */

var path = require('path');
var chalk = require('chalk');
var yargs = require('yargs/yargs');
var hideBin = require('yargs/helpers').hideBin;

// 产品名与版本从 app-info / package.json 取，不在这里硬编码
var appInfo = require('../lib/app-info');
var pkg = require('../package.json');

var VALID_COMMANDS = ['start', 'init', 'open', 'web', 'user', 'gateway'];

var COMMANDS = {
    open: 'Start a web server and open html file in your browser, if any',
    start: 'Start a web server',
    web: 'Start a web server with the visual mock console at /index.html',
    gateway: 'Start the local gateway: the console runs on this machine, requests go out from here',
    init: 'Create the sample router.js and seed the sample project',
    user: 'Manage users: add / list / reset-password'
};

/**
 * 每个命令的示例。yargs 17 移除了 .reset()，所以这里不再复用单例，
 * 而是按命令用工厂函数新建实例，参数与帮助信息互不污染。
 */
var EXAMPLES = {
    start: [
        ['--port=3000', 'set server port, default 8080'],
        ['--public=public', 'set the static file path, the default is the current folder'],
        ['--views=views', 'set the template path, the default is the current folder'],
        ['--tpl=ejs', 'set the template type, support ejs, jade, default ejs'],
        ['--db=~/.apiloop/data.db', 'set the database file, default ~/.apiloop/data.db'],
        ['--host=0.0.0.0', 'set the listen address, default 127.0.0.1'],
        ['--project=my-project', 'use this project as the root project, by slug'],
        ['--config=routes.json', 'import this legacy config file on first run']
    ],
    web: [
        ['--port=3000', 'set server port, default 8080'],
        ['--public=public', 'set the static file path, the default is the current folder'],
        ['--views=views', 'set the template path, the default is the current folder'],
        ['--tpl=ejs', 'set the template type, support ejs, jade, default ejs'],
        ['--db=~/.apiloop/data.db', 'set the database file, default ~/.apiloop/data.db'],
        ['--host=0.0.0.0', 'set the listen address, default 127.0.0.1'],
        ['--project=my-project', 'use this project as the root project, by slug'],
        ['--config=routes.json', 'import this legacy config file on first run']
    ],
    open: [
        ['--port=3000', 'set server port, default 8080'],
        ['--public=public', 'set the static file path, the default is the current folder'],
        ['--views=views', 'set the template path, the default is the current folder'],
        ['--tpl=ejs', 'set the template type, support ejs, jade'],
        ['--db=~/.apiloop/data.db', 'set the database file, default ~/.apiloop/data.db'],
        ['--host=0.0.0.0', 'set the listen address, default 127.0.0.1'],
        ['--project=my-project', 'use this project as the root project, by slug'],
        ['--config=routes.json', 'import this legacy config file on first run']
    ],
    init: [],
    user: [
        ['add <username>', 'create a user and print a one-time password'],
        ['add <username> --admin', 'create an admin'],
        ['add <username> --password hello123', 'create a user with a given password'],
        ['list', 'list users'],
        ['reset-password <username>', 'reset a user password']
    ],
    gateway: [
        ['--cloud=http://localhost:8080', 'cloud address; overrides and rewrites <data dir>/gateway.json'],
        ['--port=47321', 'listen port on 127.0.0.1, default 47321 (falls back to 47322-47329 when busy)'],
        ['--log-file=~/Library/Logs/apiloop/gateway.log', 'log file; - prints to the terminal (macOS default: ~/Library/Logs/apiloop/gateway.log)']
    ]
};

/**
 * @param {{cli: object, [whitelist]: array, [cb]: function}} opts
 * @returns {*}
 */
function handleCli(opts) {
    return require("../lib/command")(opts);
}

module.exports = handleCli;

/**
 * 用户可能通过 apiloop / mock 任一 bin 名调用，帮助信息里显示实际用的那个
 * @returns {string}
 */
function getScriptName() {
    return path.basename(process.argv[1] || 'mock');
}

/**
 * @param {string} name
 */
function showRootHelp(name) {
    var parser = yargs([])
        .scriptName(name)
        .usage('Usage: ' + chalk.green(name + ' <command> [options]'));

    Object.keys(COMMANDS).forEach(function (command) {
        parser.command(command, COMMANDS[command]);
    });

    parser
        .epilogue(chalk.bold(appInfo.APP_NAME) + ' v' + pkg.version + ' — ' + pkg.description +
            '\n\nFor more use, enter ' + chalk.green(name + ' <command> --help') +
            '\nFor example: ' + chalk.green(name + ' start --help'))
        .showHelp();
}

/**
 * @param {string} command
 * @param {string} name
 * @returns {object} 解析后的 argv，形如 { _: ['start'], port: 3000, ... }
 */
function parseCommand(command, name) {
    var parser = yargs(hideBin(process.argv))
        .scriptName(name)
        .usage('Usage: ' + chalk.green(name + ' ' + command + ' [options]') + '\n\n' + COMMANDS[command]);

    EXAMPLES[command].forEach(function (item) {
        parser.example(chalk.green(name + ' ' + command + ' ' + item[0]), item[1]);
    });

    // --help 交给 yargs 处理：打印用法后自行退出
    return parser.help().parse();
}

/**
 * @param {string} command
 * @param {string} name
 */
function handleIncoming(command, name) {
    var args = parseCommand(command, name);
    handleCli({ command: args._[0], args: args });
}

if (require.main === module) {
    var name = getScriptName();
    var command = hideBin(process.argv)[0];

    if (VALID_COMMANDS.indexOf(command) === -1) {
        showRootHelp(name);
        // 没给命令属于用法展示，给了非法命令才算错误
        process.exit(command && command.charAt(0) !== '-' ? 1 : 0);
    }

    handleIncoming(command, name);
}
